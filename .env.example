# ==============================================================================
# MapVeri Environment Configuration (.env.example)
# DO NOT COMMIT THE ACTUAL .env FILE TO VERSION CONTROL (GITHUB)
# ==============================================================================

# Database Connection (Local PostgreSQL or Supabase Postgres URI)
# Example for local Docker / native: postgres://postgres:password@localhost:5432/mapveri_db
# Example for Supabase: postgres://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgres://postgres:password@localhost:5432/mapveri_db

# API Server Port
PORT=5000

# Backend JWT Secret Key (Generate a random string: e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-with-a-secure-random-32-byte-hex-secret

# Frontend Base Path
BASE_PATH=/

# ------------------------------------------------------------------------------
# Supabase Configuration (Get from Supabase Dashboard -> Project Settings -> API)
# ------------------------------------------------------------------------------
# Public Anon Key and URL (Safe for client-side Vite / Vercel frontend)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Keep strictly private on backend / serverless)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
# Authorized Redirect URI for Supabase: https://<your-project-ref>.supabase.co/auth/v1/callback
# Authorized Redirect URI for Direct API: https://localhost:5173/login?oauth_callback=google
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ------------------------------------------------------------------------------
# Zoho OAuth (Zoho API Console -> Server-based Applications)
# ------------------------------------------------------------------------------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=

# ------------------------------------------------------------------------------
# Microsoft Outlook / Entra ID (Azure Portal -> Microsoft Entra ID)
# ------------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
