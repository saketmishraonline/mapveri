# MapVeri Frontend Environment (.env.example)
# Public variables exposed to Vite client build must start with VITE_

# Supabase Auth Project credentials (from Supabase Dashboard -> Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# API Backend Proxy Target (optional, defaults to http://127.0.0.1:5000 in dev)
# In production on Vercel or Docker, configure this if API is hosted externally
# VITE_API_URL=https://api.yourdomain.com
